# Required: model provider
OPENAI_API_KEY=

# Required: Slack Socket Mode credentials
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-

# Required in production: random value with at least 32 characters
VISITOR_COOKIE_SECRET=

# Optional: public workspace details shown in the template UI
SLACK_WORKSPACE_NAME=
SLACK_WORKSPACE_URL=https://example.slack.com

# Optional: sync the agent and send privacy-safe run analytics to Amarsia
AMARSIA_PROJECT_KEY=
AMARSIA_API_URL=https://api.amarsia.com

# Optional: durable JSONL session storage
ORCHA_SESSION_DIRECTORY=.orcha/sessions
